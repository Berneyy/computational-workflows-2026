FROM debian:bookworm-slim

LABEL image.author.name="Adrian Bernhardt"
LABEL image.author.email="adrian.bernhardt@googlemail.com"

# Install dependencies
RUN apt-get update && \
    apt install -y \
    curl 

# Download and install Salmon
RUN curl -L -o usr/bin/salmon-1.5.2_linux_x86_64.tar.gz https://github.com/COMBINE-lab/salmon/releases/download/v1.5.2/salmon-1.5.2_linux_x86_64.tar.gz
RUN tar -zxvf usr/bin/salmon-1.5.2_linux_x86_64.tar.gz -C usr/bin 
RUN ln -s /usr/bin/salmon-1.5.2_linux_x86_64/bin/salmon /usr/local/bin/salmon

# Set the PATH environment variable (to /usr/bin)
ENV PATH /usr/bin:$PATH

